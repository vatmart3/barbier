# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://degrade-barbier.vercel.app

# Resend (https://resend.com) — laisser vide pour le mode démo :
# les formulaires fonctionnent, les messages sont seulement journalisés côté serveur.
RESEND_API_KEY=
# Expéditeur vérifié dans Resend, ex. "Dégradé <rdv@votre-domaine.fr>"
RESEND_FROM=
# Adresse qui reçoit les réservations et questions (par défaut : email de src/config/site.ts)
SALON_EMAIL=
